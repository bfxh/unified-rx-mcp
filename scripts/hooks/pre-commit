#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 bfxh
# SPDX-License-Identifier: MIT
# pre-commit — 写完即验物理强制（2026-08-20 用户批评"写代码没检查"）
# 每次 git commit 前自动跑 dev_check（变更文件四连：语法+bug_scan+相关测试+语义回归）。
# 不过不许提交——把"写完即验"从规则变成物理约束。
# 跳过：git commit --no-verify（紧急情况显式绕过，默认不许）
set -uo pipefail
cd "$(dirname "$0")/../.."

# 变更文件（含已暂存）
FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | head -20)
if [ -z "$FILES" ]; then
  exit 0  # 无代码变更（纯文档/删除等）不拦截
fi

# 只对代码文件强制（.py/.rs/.go/.ts/.js/.c/.cpp 等）
CODE=0
for f in $FILES; do
  case "$f" in
    *.py|*.rs|*.go|*.ts|*.tsx|*.js|*.jsx|*.gd|*.c|*.cpp|*.h|*.hpp|*.cc|*.cs|*.lua|*.sh|*.java|*.kt|*.rb|*.php|*.dart)
      CODE=1 ;;
  esac
done
if [ "$CODE" = "0" ]; then
  exit 0
fi

echo "=== pre-commit: 写完即验（dev_check 四连）==="
# 完整四连（语义回归几秒，写完即验必须含——2026-08-20 修复：--quick 会跳过它）
python scripts/dev_check.py $FILES
RC=$?
if [ $RC -ne 0 ]; then
  echo ""
  echo "[BLOCKED] dev_check 未通过——不许带病提交（用户规则：写完代码就跑测试）"
  echo "  修复后重新 git add + git commit；紧急绕过：git commit --no-verify（默认不许）"
  exit 1
fi
echo "=== pre-commit 通过 ==="
exit 0
