{
  "description": "工具熔断（zcode-breaker）+ 会话烧量哨兵（session-guard，S141）：同一（工具+参数）窗口内重复超阈值 → 阻断；同一 key 结果连续相同 → 阻断；重复指令 → 告警；会话 model-io 越档（15/30/50/80MB）→ 注入收尾建议。阈值/窗口/冷却在 args 里调。",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "python",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/breaker_hook.py",
              "pre",
              "10",
              "300",
              "120"
            ],
            "timeoutMs": 5000,
            "statusMessage": "熔断器检查…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "python",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/breaker_hook.py",
              "post",
              "10",
              "300",
              "120"
            ],
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "python",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/breaker_hook.py",
              "postfail",
              "10",
              "300",
              "120"
            ],
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "python",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/breaker_hook.py",
              "prompt",
              "10",
              "300",
              "120"
            ],
            "timeoutMs": 5000
          },
          {
            "type": "process",
            "command": "python",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/session_guard_hook.py",
              "prompt"
            ],
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "python",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/session_guard_hook.py",
              "start"
            ],
            "timeoutMs": 5000,
            "statusMessage": "会话卫生检查…"
          }
        ]
      }
    ]
  }
}
