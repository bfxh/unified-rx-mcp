{
  "_comment": "外部模板规则（Nuclei 概念：确定性规则 DSL——不改代码加规则）。格式：{id, pattern(正则), language(.py/.rs/all), severity, msg}。环境变量 UNIFIED_RX_VULN_RULES 可指向自定义规则文件。",
  "rules": [
    {
      "id": "sql_injection",
      "pattern": "(execute|executemany|query)\\s*\\(\\s*f?[\"']?.*(SELECT|INSERT|UPDATE|DELETE).*\\+",
      "language": ".py",
      "severity": "warning",
      "msg": "SQL 字符串拼接（f-string/+ 拼接 SQL——注入风险，建议参数化查询）"
    },
    {
      "id": "ssrf_open_url",
      "pattern": "urlopen\\s*\\(\\s*[a-z_]",
      "language": ".py",
      "severity": "warning",
      "msg": "urlopen 接收变量 URL（用户可控时 SSRF——建议白名单/内网拒绝）"
    },
    {
      "id": "zip_slip",
      "pattern": "ZipFile\\s*\\(|zipfile\\.",
      "language": ".py",
      "severity": "info",
      "msg": "zipfile 解压（恶意 zip 成员路径穿越——建议成员路径校验）"
    },
    {
      "id": "proto_pollution",
      "pattern": "__proto__|prototype\\s*=",
      "language": ".js",
      "severity": "warning",
      "msg": "原型污染（__proto__/prototype 赋值——对象原型被篡改，建议白名单键）"
    },
    {
      "id": "log_injection",
      "pattern": "logging\\..*\\(f?[\"'].*\\{.*\\}",
      "language": ".py",
      "severity": "info",
      "msg": "日志格式化含变量（换行注入伪造日志——建议转义/结构化日志）"
    },
    {
      "id": "sql_injection_js",
      "pattern": "(execute|query)\\s*\\(\\s*[`\"'].*(SELECT|INSERT|UPDATE|DELETE).*\\$\\{",
      "language": ".js",
      "severity": "warning",
      "msg": "JS SQL 模板串拼接（${} 插值注入——建议参数化查询）"
    },
    {
      "id": "xxe_unsafe",
      "pattern": "(ElementTree|ET)\\.(parse|fromstring)|etree\\s*\\.\\s*parse|XMLParser\\s*\\(",
      "language": ".py",
      "severity": "info",
      "msg": "XML 解析未禁用外部实体（XXE 风险——建议 defusedxml/禁止 DTD）"
    },
    {
      "id": "command_var_subprocess",
      "pattern": "(getoutput|popen)\\s*\\(",
      "language": ".py",
      "severity": "warning",
      "msg": "命令执行（getoutput/popen——shell 语义，参数含用户输入即注入，建议 subprocess 列表参数）"
    },
    {
      "id": "php_file_include",
      "pattern": "(include|require)\\s*\\(?\\s*\\$",
      "language": ".php",
      "severity": "warning",
      "msg": "PHP 文件包含变量（include $var——远程包含/路径穿越，建议白名单）"
    },
    {
      "id": "go_race_shared",
      "pattern": "go\\s+func[^{]*\\{[^}]*\\[[^]]*\\]\\s*=",
      "language": ".go",
      "severity": "info",
      "msg": "goroutine 内索引赋值（map/slice 共享写——并发竞态，建议加锁/通道）"
    },
    {
      "id": "js_dynamic_eval",
      "pattern": "\\beval\\s*\\(\\s*(?!['\\\"`])",
      "language": ".js",
      "severity": "error",
      "msg": "动态 eval 执行不可信输入——代码注入面（建议替代方案）"
    },
    {
      "id": "py_pickle_untrusted",
      "pattern": "pickle\\.loads\\s*\\(\\s*(?!b?['\\\"])",
      "language": ".py",
      "severity": "error",
      "msg": "pickle.loads 反序列化不可信数据——任意代码执行（建议 json/safe 格式）"
    },
    {
      "id": "go_http_var_url",
      "pattern": "http\\.(Get|Post|Do)\\s*\\(\\s*[a-zA-Z_]",
      "language": ".go",
      "severity": "warning",
      "msg": "HTTP 请求 URL 为变量——确认无用户可控注入（SSRF 面）"
    },
    {
      "id": "js_innerhtml_untrusted",
      "pattern": "\\.innerHTML\\s*=\\s*[a-zA-Z_]",
      "language": ".js",
      "severity": "warning",
      "msg": "innerHTML 赋值变量——XSS 注入面（建议 textContent 或转义）"
    }
  ]
}