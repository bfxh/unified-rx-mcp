{
  "note": "高压语料（S162）：每条 = 一个可复现的施压场景。**判据是数据，脚本只是跑它的机器**（见 docs/STRESS-AND-PR-GATES.md §3）。两条硬规矩：① 每条必须给出 expect=success|error —— 首版压测把「本该成功」的用例当错误期望，得出 91.7% 的假阴性；② 用互不相同的输入时才测并发（同参会命中 S103 缓存，量到的是缓存不是并行）。占位符 $<fixture> 由 runner 在临时目录里物化，故语料里**没有绝对路径**（也过 path 门）。",
  "fixtures": {
    "small_py": {"text": "def f(p):\n    return open(p).read()\n", "kind": "file"},
    "other_py": {"text": "def g(q):\n    return 1\n", "kind": "file"},
    "big_txt": {"text_len": 204800, "fill": "x", "kind": "file"},
    "huge_str": {"kind": "arg", "repeat": 3000000, "fill": "x"}
  },
  "cases": [
    {"name": "err-missing-required", "tier": "fast", "tool": "fs_read", "args": {},
     "expect": "error", "why": "缺必填 ⇒ 必须结构化错误 + next（弱模型靠 next 修参数）"},
    {"name": "err-empty-value", "tier": "fast", "tool": "fs_read", "args": {"path": ""},
     "expect": "error", "why": "空值不等于合法输入"},
    {"name": "err-outside-sandbox", "tier": "fast", "tool": "fs_read",
     "args": {"path": "C:/Windows/win.ini"}, "expect": "error", "why": "沙盒 fail-closed"},
    {"name": "err-unauthorized-write", "tier": "fast", "tool": "fs_write",
     "args": {"path": "$small_py", "content": "x"}, "expect": "error",
     "why": "写操作必须显式 __authorized"},
    {"name": "err-unknown-tool", "tier": "fast", "tool": "no_such_tool_xyz", "args": {},
     "expect": "error", "why": "未知工具要判错，不能静默当成功"},
    {"name": "err-oversized-arg", "tier": "full", "tool": "fs_read",
     "args": {"path": "$huge_str"}, "expect": "error", "why": "入口尺寸门（3MB > 2MB 上限）"},
    {"name": "ok-read", "tier": "fast", "tool": "fs_read", "args": {"path": "$small_py"},
     "expect": "success", "why": "正常读——对照项：证明解析路径是通的（取不到值≠值为0的教训）"},
    {"name": "ok-stat", "tier": "fast", "tool": "fs_stat", "args": {"path": "$other_py"},
     "expect": "success", "why": "同上，对照项"},
    {"name": "ok-spill-big", "tier": "full", "tool": "fs_read", "args": {"path": "$big_txt"},
     "expect": "success", "assert": {"spilled": true}, "why": "200KB 结果必须溢出落盘 + 给 fetch"},
    {"name": "ok-route-callers", "tier": "fast", "tool": "capability_manifest",
     "args": {"intent": "找出哪些地方调用了这个函数"}, "expect": "success",
     "assert": {"contains": ["ide_callgraph"]}, "why": "F5 路由：curated 簇命中"},
    {"name": "ok-route-review", "tier": "fast", "tool": "capability_manifest",
     "args": {"intent": "评审一下这个补丁"}, "expect": "success",
     "assert": {"contains": ["code_review"]}, "why": "F5 路由：评审"},
    {"name": "ok-route-build", "tier": "fast", "tool": "capability_manifest",
     "args": {"intent": "编译报错了怎么办"}, "expect": "success",
     "assert": {"contains": ["ide_build"]}, "why": "F5 路由：编译"},
    {"name": "ok-route-dead", "tier": "full", "tool": "capability_manifest",
     "args": {"intent": "哪些文件没被用到"}, "expect": "success",
     "assert": {"contains": ["ide_dead_code"]}, "why": "F5 路由：中文变形（没被用到）"},
    {"name": "ok-route-rename", "tier": "full", "tool": "capability_manifest",
     "args": {"intent": "重命名这个符号"}, "expect": "success",
     "assert": {"contains": ["ide_rename"]}, "why": "F5 路由：重命名"},
    {"name": "ok-route-health", "tier": "full", "tool": "capability_manifest",
     "args": {"intent": "看看项目整体健康度"}, "expect": "success",
     "assert": {"contains": ["project_health"]}, "why": "F5 路由：体检"},
    {"name": "ok-manifest-legacy", "tier": "full", "tool": "capability_manifest", "args": {},
     "expect": "success", "assert": {"keys": ["定位", "有", "没有", "高权限", "工具面", "分组"]},
     "why": "不带 intent 时旧形状必须原样保留（既有消费方）"},
    {"name": "ok-hallucination-guard", "tier": "full", "tool": "hallucination_guard",
     "args": {"text": "`fs_read` 存在于 `tools/fs.py:1`"}, "expect": "success",
     "why": "防幻觉域的对照项（有 verified 结果）"},
    {"name": "ok-sys-topology", "tier": "full", "tool": "sys_topology", "args": {},
     "expect": "success", "assert": {"keys": ["vendor"]},
     "why": "平凡成功项（协议面门也在用它）——顺带当'回包预算'的对照"}
  ],
  "concurrency": {
    "note": "并发档需**机器级独占**（perf_lock.py）且**必须用互不相同的输入**——同参会命中 S103 内容寻址缓存，量到的是缓存（实测：并发 4 个同参 7ms 比单次 28ms 还快，那是缓存不是并行）。",
    "cases": [
      {"name": "parallel-8-distinct", "tool": "bug_scan", "n": 8, "distinct_inputs": true,
       "fixture": "small_py", "assert": {"wall_vs_serial_lt": 0.6},
       "why": "服务端 tools/call 走 4 worker 线程池 ⇒ 并发应显著快于串行和；实测 10ms vs 30ms"}
    ]
  }
}
